{
  "rules": [
    {"id":"deny-secret-read","action":"secret.read","environment":"*","decision":"deny","reason":"Secrets are not readable by default."},
    {"id":"deny-secret-export","action":"secret.export","environment":"*","decision":"deny","reason":"Secret export is prohibited."},
    {"id":"approval-pr-merge","action":"pr.merge","resource":"github_pr","environment":"*","decision":"approval","reason":"Landing a pull request requires explicit confirmation bound to the current PR head."},
    {"id":"approval-prod-deploy","action":"deploy.production","resource":"deploy","environment":"production","decision":"approval","reason":"Production deployment requires explicit approval."},
    {"id":"approval-prod-db","action":"db.*","resource":"database","environment":"production","decision":"approval","reason":"Production database writes/migrations require explicit approval."},
    {"id":"approval-external-message","action":"message.send_external","resource":"messaging","environment":"*","decision":"approval","reason":"External messaging requires explicit approval unless already authorized by the user task."},
    {"id":"approval-billing","action":"billing.*","resource":"billing","environment":"*","decision":"approval","reason":"Billing and spend changes require explicit approval."},
    {"id":"approval-iam","action":"iam.*","resource":"iam","environment":"*","decision":"approval","reason":"IAM and permission changes require explicit approval."},
    {"id":"allow-read","action":"repo.read","resource":"repo","environment":"*","decision":"allow","reason":"Repository reads are reversible and within normal execution scope."},
    {"id":"allow-feature-write","action":"repo.write","resource":"repo","environment":"development","decision":"allow","reason":"Feature-branch repository writes are allowed within the requested task scope."},
    {"id":"allow-local-write","action":"repo.write","resource":"repo","environment":"local","decision":"allow","reason":"Local working-tree edits are allowed."},
    {"id":"allow-tests","action":"test.run","resource":"tests","environment":"*","decision":"allow","reason":"Non-production test execution is allowed."},
    {"id":"allow-search","action":"search.public","resource":"public_search","environment":"*","decision":"allow","reason":"Public research is allowed."},
    {"id":"allow-pr-create","action":"pr.create","resource":"github_pr","environment":"development","decision":"allow","reason":"Creating a reviewable pull request from a feature branch is allowed."},
    {"id":"allow-pr-comment","action":"pr.comment","resource":"github_pr","environment":"development","decision":"allow","reason":"PR review/reply comments are allowed during the requested completion workflow."},
    {"id":"allow-ci-rerun","action":"ci.rerun","resource":"ci","environment":"development","decision":"allow","reason":"Rerunning failed CI checks is allowed when evidence indicates a justified retry."},
    {"id":"approval-staging-deploy","action":"deploy.staging","resource":"deploy","environment":"staging","decision":"approval","reason":"The embedded AISearch pilot does not deploy staging without explicit approval."}
  ]
}
