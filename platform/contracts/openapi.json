{
  "components": {
    "schemas": {
      "CapabilitiesResponse": {
        "properties": {
          "api_version": {
            "title": "Api Version",
            "type": "string"
          },
          "authentication": {
            "default": false,
            "title": "Authentication",
            "type": "boolean"
          },
          "crawling": {
            "default": false,
            "title": "Crawling",
            "type": "boolean"
          },
          "generated_answers": {
            "default": false,
            "title": "Generated Answers",
            "type": "boolean"
          },
          "payments": {
            "default": false,
            "title": "Payments",
            "type": "boolean"
          },
          "rag": {
            "default": false,
            "title": "Rag",
            "type": "boolean"
          },
          "retrieval_mode": {
            "default": "lexical-v1",
            "title": "Retrieval Mode",
            "type": "string"
          }
        },
        "required": [
          "api_version"
        ],
        "title": "CapabilitiesResponse",
        "type": "object"
      },
      "ClaimSummary": {
        "properties": {
          "claim_key": {
            "title": "Claim Key",
            "type": "string"
          },
          "claim_type": {
            "title": "Claim Type",
            "type": "string"
          },
          "confidence": {
            "title": "Confidence",
            "type": "string"
          },
          "review_status": {
            "title": "Review Status",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "verified_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Verified At"
          }
        },
        "required": [
          "claim_key",
          "text",
          "claim_type",
          "confidence",
          "review_status"
        ],
        "title": "ClaimSummary",
        "type": "object"
      },
      "ContentDetail": {
        "properties": {
          "body": {
            "title": "Body",
            "type": "string"
          },
          "claims": {
            "items": {
              "$ref": "#/components/schemas/ClaimSummary"
            },
            "title": "Claims",
            "type": "array"
          },
          "language": {
            "title": "Language",
            "type": "string"
          },
          "published_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published At"
          },
          "section": {
            "title": "Section",
            "type": "string"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceSummary"
            },
            "title": "Sources",
            "type": "array"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "slug",
          "title",
          "summary",
          "body",
          "section",
          "language",
          "status",
          "updated_at"
        ],
        "title": "ContentDetail",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "service": {
            "default": "aisearcharab-api",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "SearchResponse": {
        "properties": {
          "algorithm_version": {
            "default": "lexical-v1",
            "title": "Algorithm Version",
            "type": "string"
          },
          "limit": {
            "title": "Limit",
            "type": "integer"
          },
          "normalized_query": {
            "title": "Normalized Query",
            "type": "string"
          },
          "offset": {
            "title": "Offset",
            "type": "integer"
          },
          "query": {
            "title": "Query",
            "type": "string"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/SearchResult"
            },
            "title": "Results",
            "type": "array"
          },
          "retrieval_mode": {
            "default": "retrieval-only",
            "title": "Retrieval Mode",
            "type": "string"
          },
          "took_ms": {
            "title": "Took Ms",
            "type": "number"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "query",
          "normalized_query",
          "total",
          "limit",
          "offset",
          "took_ms",
          "results"
        ],
        "title": "SearchResponse",
        "type": "object"
      },
      "SearchResult": {
        "properties": {
          "language": {
            "title": "Language",
            "type": "string"
          },
          "matched_fields": {
            "items": {
              "type": "string"
            },
            "title": "Matched Fields",
            "type": "array"
          },
          "published_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published At"
          },
          "score": {
            "title": "Score",
            "type": "number"
          },
          "section": {
            "title": "Section",
            "type": "string"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "source_authority": {
            "title": "Source Authority",
            "type": "number"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "slug",
          "title",
          "summary",
          "section",
          "language",
          "score",
          "matched_fields",
          "source_authority"
        ],
        "title": "SearchResult",
        "type": "object"
      },
      "SourceSummary": {
        "properties": {
          "archive_url": {
            "anyOf": [
              {
                "format": "uri",
                "maxLength": 2083,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Archive Url"
          },
          "publisher": {
            "title": "Publisher",
            "type": "string"
          },
          "reliability": {
            "title": "Reliability",
            "type": "string"
          },
          "source_key": {
            "title": "Source Key",
            "type": "string"
          },
          "source_type": {
            "title": "Source Type",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "url": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "source_key",
          "title",
          "publisher",
          "url",
          "source_type",
          "reliability"
        ],
        "title": "SourceSummary",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Arabic-first retrieval API. Phase 2 is retrieval-only and does not generate answers.",
    "title": "AISearcharab API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "liveness_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "readiness_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readiness",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/content/{slug}": {
      "get": {
        "operationId": "content_detail_v1_content__slug__get",
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "title": "Slug",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContentDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Content Detail",
        "tags": [
          "content"
        ]
      }
    },
    "/v1/meta/capabilities": {
      "get": {
        "operationId": "capabilities_v1_meta_capabilities_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilitiesResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Capabilities",
        "tags": [
          "meta"
        ]
      }
    },
    "/v1/search": {
      "get": {
        "operationId": "search_content_v1_search_get",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "maxLength": 120,
              "minLength": 2,
              "title": "Q",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 10,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "maximum": 10000,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Search Content",
        "tags": [
          "search"
        ]
      }
    }
  }
}
