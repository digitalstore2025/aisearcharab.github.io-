# Search is fail-closed and disabled unless this explicit gate is true.
AISEARCH_SEARCH_ENABLED=false
# Server-side only. Browser code must never receive or construct this upstream URL.
AISEARCH_API_BASE_URL=http://127.0.0.1:8000
# Used only to turn validated API content paths into public links.
AISEARCH_PUBLIC_SITE_ORIGIN=https://aisearcharab.com
