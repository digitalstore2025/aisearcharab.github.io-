APP_ENV=development
DATABASE_URL=postgresql+psycopg://aisearcharab:change-me@postgres:5432/aisearcharab
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://aisearcharab.com
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,aisearcharab.com
API_PREFIX=/v1
MAX_SEARCH_LIMIT=20
SEARCH_CANDIDATE_LIMIT=300
MAX_REQUEST_BODY_BYTES=524288
LOG_SEARCH_QUERIES=false
# Required only when LOG_SEARCH_QUERIES=true; use at least 32 random bytes.
QUERY_HASH_KEY=
SESSION_TTL_MINUTES=720
SESSION_IDLE_MINUTES=30
# Short-lived password re-authentication window for privileged mutations.
STEP_UP_TTL_MINUTES=10
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
PASSWORD_MIN_LENGTH=14
# Must be true in production. Requires distinct creator, reviewer and publisher identities.
ENFORCE_SEPARATION_OF_DUTIES=false
POSTGRES_DB=aisearcharab
POSTGRES_USER=aisearcharab
POSTGRES_PASSWORD=change-me
