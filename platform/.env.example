APP_ENV=development
DATABASE_URL=postgresql+psycopg://aisearcharab:change-me@postgres:5432/aisearcharab
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://aisearcharab.com
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,aisearcharab.com
API_PREFIX=/v1
MAX_SEARCH_LIMIT=20
SEARCH_CANDIDATE_LIMIT=300
MAX_REQUEST_BODY_BYTES=524288
LOG_SEARCH_QUERIES=false
# Required only when LOG_SEARCH_QUERIES=true; use at least 32 random bytes.
QUERY_HASH_KEY=
SESSION_TTL_MINUTES=720
SESSION_IDLE_MINUTES=30
# Short-lived password re-authentication window for privileged mutations.
STEP_UP_TTL_MINUTES=10
# These counters are retained for authenticated step-up/MFA failures only.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# Pre-auth login abuse is throttled per HMAC(source, account), persisted in the DB.
# Required in staging/production; minimum 32 random bytes from a secret manager.
LOGIN_THROTTLE_KEY=
LOGIN_THROTTLE_MAX_FAILURES=8
LOGIN_THROTTLE_WINDOW_SECONDS=300
LOGIN_THROTTLE_BLOCK_SECONDS=300
# Optional. Set only to the exact reverse-proxy networks that are allowed to
# supply X-Forwarded-For. Empty means forwarding headers are always ignored.
# Never use 0.0.0.0/0 or ::/0.
TRUSTED_PROXY_CIDRS=
PASSWORD_MIN_LENGTH=14
# Must be true in production. Requires distinct creator, reviewer and publisher identities.
ENFORCE_SEPARATION_OF_DUTIES=false
# Must be true in staging/production. Applies to owner/admin/publisher roles.
REQUIRE_MFA_FOR_PRIVILEGED=false
# Secret-manager value, minimum 32 random bytes. Never commit a real value.
MFA_ENCRYPTION_KEY=
MFA_ENROLLMENT_TTL_MINUTES=10
MFA_ISSUER=AISearcharab.com

# Grounded generated answers are beta and disabled by default. The endpoint is
# authenticated and retrieves only published/indexed AISearcharab content.
GENERATED_ANSWERS_ENABLED=false
# Secret-manager value. Required only when GENERATED_ANSWERS_ENABLED=true.
# Never commit a real OpenAI API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=2
OPENAI_MAX_OUTPUT_TOKENS=1200
GENERATED_ANSWER_MAX_SOURCES=5
GENERATED_ANSWER_MAX_EVIDENCE_CHARS=6000

POSTGRES_DB=aisearcharab
POSTGRES_USER=aisearcharab
POSTGRES_PASSWORD=change-me
